{
  "name": "@hb/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:ui",
    "dev:ui": "pnpm --filter @hb/admin-ui dev",
    "dev:server": "cargo run -p herta_server serve",
    "dev:server:mem": "cargo run -p herta_server -- serve --db-engine memory",
    "build": "pnpm build:sdk && pnpm build:ui && pnpm build:server",
    "build:sdk": "pnpm --filter @hb/sdk build",
    "build:ui": "pnpm --filter @hb/admin-ui build",
    "build:server": "cargo build --release",
    "lint": "pnpm lint:sdk && pnpm lint:ui && pnpm lint:server",
    "lint:sdk": "pnpm --filter @hb/sdk lint",
    "lint:ui": "pnpm --filter @hb/admin-ui lint",
    "lint:server": "cargo clippy --workspace -- -D warnings",
    "fmt": "pnpm fmt:sdk && pnpm fmt:ui && pnpm fmt:server",
    "fmt:sdk": "pnpm --filter @hb/sdk format",
    "fmt:ui": "pnpm --filter @hb/admin-ui fmt",
    "fmt:server": "cargo fmt --all",
    "fmt:check": "pnpm fmt:check:sdk && pnpm fmt:check:ui && pnpm fmt:check:server",
    "fmt:check:sdk": "pnpm --filter @hb/sdk format:check",
    "fmt:check:ui": "pnpm --filter @hb/admin-ui fmt:check",
    "fmt:check:server": "cargo fmt --all -- --check",
    "test:rust": "cargo test --workspace",
    "test:sdk": "pnpm --filter @hb/sdk test",
    "test:integration": "pnpm --filter blog-demo-integration test && pnpm --filter kanban-demo-integration test",
    "test:integration:blog": "pnpm --filter blog-demo-integration test",
    "test:integration:kanban": "pnpm --filter kanban-demo-integration test",
    "test:integration:kanban:release": "pnpm --filter kanban-demo-integration test:release",
    "test": "pnpm test:sdk && pnpm test:rust && pnpm test:integration"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
